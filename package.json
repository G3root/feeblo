{
  "name": "feeblo",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "integrations/*",
      "packages/*",
      "e2e"
    ]
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo run test --continue --filter=!@feeblo/e2e --concurrency=4",
    "test:e2e": "pnpm --filter @feeblo/e2e test",
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F @feeblo/web -F @feeblo/public-feature-board dev",
    "dev:server": "turbo -F server dev",
    "db:push": "turbo -F @feeblo/db db:push",
    "db:studio": "turbo -F @feeblo/db db:studio",
    "db:generate": "turbo -F @feeblo/db db:generate",
    "db:migrate": "turbo -F @feeblo/db db:migrate",
    "db:nuke": "turbo -F @feeblo/db db:nuke",
    "db:seed": "turbo -F @feeblo/db db:seed",
    "db:start": "turbo -F @feeblo/db db:start",
    "db:watch": "turbo -F @feeblo/db db:watch",
    "db:stop": "turbo -F @feeblo/db db:stop",
    "db:down": "turbo -F @feeblo/db db:down",
    "db:configure-embeddings": "pnpm --filter @feeblo/db db:configure-embeddings",
    "lint": "oxlint && oxfmt --check .",
    "lint:fix": "oxlint --fix && oxfmt",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "turbo run typecheck",
    "check": "turbo run check",
    "knip": "knip",
    "toolchain": "node check-toolchain.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@dotenvx/dotenvx": "catalog:",
    "@effect/tsgo": "0.56.0",
    "@feeblo/config": "workspace:*",
    "@oxlint/plugins": "1.89.0",
    "@types/node": "catalog:",
    "knip": "catalog:",
    "oxfmt": "^0.74.0",
    "oxlint": "1.89.0",
    "oxlint-plugin-react-doctor": "^0.9.12",
    "oxlint-tsgolint": "7.0.2004",
    "turbo": "^2.10.8",
    "typescript": "catalog:"
  },
  "engines": {
    "node": "^26.4.0",
    "pnpm": "^11.0.3"
  },
  "packageManager": "pnpm@11.0.3"
}
