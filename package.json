{
  "name": "feeblo",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "integrations/*",
      "packages/*",
      "e2e"
    ]
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo run test --filter=!@feeblo/e2e",
    "test:e2e": "pnpm --filter @feeblo/e2e test",
    "check-types": "turbo check-types",
    "typecheck": "turbo check-types",
    "prepare": "effect-language-service patch",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "db:push": "turbo -F @feeblo/db db:push",
    "db:studio": "turbo -F @feeblo/db db:studio",
    "db:generate": "turbo -F @feeblo/db db:generate",
    "db:migrate": "turbo -F @feeblo/db db:migrate",
    "db:nuke": "turbo -F @feeblo/db db:nuke",
    "db:seed": "turbo -F @feeblo/db db:seed",
    "db:start": "turbo -F @feeblo/db db:start",
    "db:watch": "turbo -F @feeblo/db db:watch",
    "db:stop": "turbo -F @feeblo/db db:stop",
    "db:down": "turbo -F @feeblo/db db:down",
    "db:configure-embeddings": "pnpm --filter @feeblo/db db:configure-embeddings",
    "deploy": "turbo -F @feeblo/infra deploy",
    "destroy": "turbo -F @feeblo/infra destroy",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@dotenvx/dotenvx": "catalog:",
    "@effect/language-service": "^0.85.1",
    "@feeblo/config": "workspace:*",
    "@oxlint/plugins": "^1.78.0",
    "@types/node": "catalog:",
    "dotenv": "catalog:",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "turbo": "^2.10.8",
    "typescript": "catalog:",
    "zod": "catalog:"
  },
  "packageManager": "pnpm@11.0.3",
  "engines": {
    "node": "^26.4.0",
    "pnpm": "^11.0.3"
  }
}
