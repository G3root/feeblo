# Feeblo self-hosted stack configuration.
#
# Copy, fill, and pass it to Compose:
#
#   cp docker/.env.selfhost.example docker/.env.selfhost
#   $EDITOR docker/.env.selfhost
#   docker compose --env-file docker/.env.selfhost up -d
#
# Do not reuse the development `.env` here. Its DATABASE_URL and REDIS_URL
# point at host ports (127.0.0.1:54323 / 127.0.0.1:63799) that do not exist
# inside a container, and its APP_URL/API_URL name the dev ports. See
# docs/self-hosting.md for the deployment walkthrough.

# --- Required: database and cache (compose service names) ---
POSTGRES_USER=feeblo
# Change this and keep DATABASE_URL in sync with it.
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=feeblo
DATABASE_URL=postgres://feeblo:replace-me@pg:5432/feeblo
REDIS_URL=redis://redis:6379/0

# --- Required: public origins and release ---
# HTTPS hostnames. The dashboard and API are separate origins; public boards
# answer on subdomains of APP_ROOT_DOMAIN, so add a wildcard DNS record for it.
APP_URL=https://feedback.example.com
API_URL=https://api.feedback.example.com
APP_ROOT_DOMAIN=feedback.example.com
# Reported by GET /health and attached to telemetry.
APP_RELEASE=dev
# Staging deployments: block indexing and label telemetry.
# NO_INDEX=true
# APP_ENV=staging

# --- Required: secrets ---
# Generate with: openssl rand -hex 32
AUTH_ENCRYPTION_KEY=
# Optional: encrypt integration credentials with a second key. Falls back to
# AUTH_ENCRYPTION_KEY when unset.
# INTEGRATION_ENCRYPTION_KEY=

# --- Required: transactional email ---
# Account creation verifies the address by email. Without a working mailer,
# sign-up cannot complete unless AUTH_EMAIL_VERIFICATION_REQUIRED=false.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
# Must be a domain you control and have authenticated with your provider.
SMTP_FROM_ADDRESS=noreply@feedback.example.com
SMTP_FROM_NAME=Feeblo
# Optional: personal lifecycle sender and Reply-To.
SMTP_PERSONAL_FROM_ADDRESS=
SMTP_PERSONAL_FROM_NAME=
SMTP_REPLY_TO_ADDRESS=

# --- Required: object storage ---
# See docs/r2-production-checklist.md. With Cloudflare R2 the region is `auto`,
# the endpoint is the account's S3 endpoint, and MEDIA_PUBLIC_BASE_URL is the
# bucket's public custom domain (never the endpoint).
MEDIA_UPLOAD_REGION=auto
MEDIA_UPLOAD_ENDPOINT=
MEDIA_UPLOAD_ACCESS_KEY_ID=
MEDIA_UPLOAD_SECRET_ACCESS_KEY=
MEDIA_PUBLIC_BUCKET_NAME=feeblo-media-public
MEDIA_PUBLIC_BASE_URL=

# --- Server-side API origin (web container only) ---
# Compose defaults this to the `server` service. Override it if the API runs
# somewhere else, so SSR (public boards, feeds, telemetry relay) does not have
# to leave the compose network through the public origin.
# API_URL_INTERNAL=http://server:8080

# --- Reverse proxy and rate limits ---
# Put the API behind a TLS-terminating proxy. With neither value set, every
# anonymous request shares the proxy's IP and every per-visitor rate limit
# becomes global. Prefer a CIDR for the proxy network. TRUST_PROXY_HEADERS
# trusts every forwarding hop, so only use it when the API port is not
# directly reachable.
# TRUSTED_PROXY_IPS=172.18.0.0/16
# TRUST_PROXY_HEADERS=false

# --- Registration controls ---
# AUTH_TRUSTED_ORIGINS is derived from APP_URL, API_URL and APP_ROOT_DOMAIN.
# Add extra origins (comma-separated, wildcards allowed) for other board hosts.
# AUTH_TRUSTED_ORIGINS=
# AUTH_SIGN_UP_ENABLED=true
# AUTH_EMAIL_VERIFICATION_REQUIRED=true
# AUTH_AUTO_SIGN_IN_AFTER_SIGN_UP=false
# ALLOWED_EMAILS=
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# --- Optional: social login ---
# Register <API_URL>/api/auth/callback/github and
# <API_URL>/api/auth/callback/google as the OAuth redirect URLs.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Optional: integrations ---
# GitHub App callback: <API_URL>/github/app/installations/callback
# GitHub App webhook:  <API_URL>/github/app/webhooks
# GITHUB_INTEGRATION_APP_ID=
# GITHUB_INTEGRATION_APP_SLUG=
# GITHUB_INTEGRATION_CLIENT_ID=
# GITHUB_INTEGRATION_CLIENT_SECRET=
# GITHUB_INTEGRATION_PRIVATE_KEY=
# GITHUB_INTEGRATION_WEBHOOK_SECRET=
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_SIGNING_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_BOT_TOKEN=
# DISCORD_PUBLIC_KEY=

# --- Optional: billing ---
# POLAR_MODE=sandbox
# POLAR_ACCESS_TOKEN=
# POLAR_WEBHOOK_SECRET=

# --- Optional: error reporting, analytics, embeddings, telemetry ---
# SENTRY_DSN=
# POSTHOG_KEY=
# POSTHOG_HOST=
# EMBEDDING_API_KEY=
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=
# FEEBLO_TELEMETRY_TRACES_SAMPLE_RATE=1

# --- Optional: image tag for `docker compose pull` ---
# IMAGE_TAG=latest
