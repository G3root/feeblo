        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Queue and email metrics the Feeblo server exports over OTLP. The Service label variable defaults to job=~\"feeblo/feeblo-server\"; switch it to service_name if your stack promotes that label instead. Traces, RED metrics, and logs live in Application Observability.",
