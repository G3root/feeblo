{
  "name": "@feeblo/public-feature-board",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build:paraglide": "paraglide-js compile --project ../../project.inlang --outdir ./src/paraglide --strategy baseLocale --emit-ts-declarations",
    "check-types": "tsc --noEmit",
    "dev": "paraglide-js compile --project ../../project.inlang --outdir ./src/paraglide --strategy baseLocale --emit-ts-declarations --watch",
    "machine-translate": "inlang machine translate --project ../../project.inlang",
    "test": "vitest run"
  },
  "dependencies": {
    "@feeblo/domain": "workspace:*",
    "@feeblo/id": "workspace:*",
    "@feeblo/post-ui": "workspace:*",
    "@feeblo/ui": "workspace:*",
    "@feeblo/utils": "workspace:*",
    "@feeblo/web-shared": "workspace:",
    "@hugeicons/core-free-icons": "^4.1.1",
    "@hugeicons/react": "^1.1.6",
    "@tanstack/query-db-collection": "catalog:",
    "@tanstack/react-db": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "effect": "catalog:",
    "react": "catalog:"
  },
  "devDependencies": {
    "@feeblo/config": "workspace:*",
    "@inlang/cli": "^3.3.0",
    "@inlang/paraglide-js": "^2.23.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
