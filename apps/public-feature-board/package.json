{
  "name": "@feeblo/public-feature-board",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./board-scope": {
      "types": "./src/lib/board-scope.ts",
      "default": "./src/lib/board-scope.ts"
    },
    "./collections": {
      "types": "./src/lib/collections.ts",
      "default": "./src/lib/collections.ts"
    },
    "./components/pending": {
      "types": "./src/components/layout/public-board-pending.tsx",
      "default": "./src/components/layout/public-board-pending.tsx"
    },
    "./components/shell": {
      "types": "./src/components/layout/public-board-shell.tsx",
      "default": "./src/components/layout/public-board-shell.tsx"
    },
    "./i18n": {
      "types": "./src/i18n.ts",
      "default": "./src/i18n.ts"
    },
    "./pages/board": {
      "types": "./src/pages/board-page.tsx",
      "default": "./src/pages/board-page.tsx"
    },
    "./pages/changelog": {
      "types": "./src/pages/change-log-page.tsx",
      "default": "./src/pages/change-log-page.tsx"
    },
    "./pages/changelog-detail": {
      "types": "./src/pages/change-log-detail-page.tsx",
      "default": "./src/pages/change-log-detail-page.tsx"
    },
    "./pages/home": {
      "types": "./src/pages/home-page.tsx",
      "default": "./src/pages/home-page.tsx"
    },
    "./pages/not-found": {
      "types": "./src/pages/not-found-page.tsx",
      "default": "./src/pages/not-found-page.tsx"
    },
    "./pages/post": {
      "types": "./src/pages/post-page.tsx",
      "default": "./src/pages/post-page.tsx"
    },
    "./pages/roadmap": {
      "types": "./src/pages/roadmap-page.tsx",
      "default": "./src/pages/roadmap-page.tsx"
    },
    "./providers/site-provider": {
      "types": "./src/providers/site-provider.tsx",
      "default": "./src/providers/site-provider.tsx"
    },
    "./sso-token": {
      "types": "./src/lib/sso-token.ts",
      "default": "./src/lib/sso-token.ts"
    }
  },
  "scripts": {
    "build:paraglide": "paraglide-js compile --project ../../project.inlang --outdir ./src/paraglide --strategy baseLocale --emit-ts-declarations",
    "dev": "paraglide-js compile --project ../../project.inlang --outdir ./src/paraglide --strategy baseLocale --emit-ts-declarations --watch",
    "machine-translate": "inlang machine translate --project ../../project.inlang",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/atom-react": "catalog:",
    "@feeblo/domain": "workspace:*",
    "@feeblo/id": "workspace:*",
    "@feeblo/post-ui": "workspace:*",
    "@feeblo/rpc-client": "workspace:*",
    "@feeblo/ui": "workspace:*",
    "@feeblo/utils": "workspace:*",
    "@feeblo/web-shared": "workspace:",
    "@hugeicons/core-free-icons": "^4.1.1",
    "@hugeicons/react": "^1.1.6",
    "@tanstack/query-db-collection": "catalog:",
    "@tanstack/react-db": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-start": "catalog:",
    "effect": "catalog:",
    "react": "catalog:"
  },
  "devDependencies": {
    "@feeblo/config": "workspace:*",
    "@inlang/cli": "^3.3.0",
    "@inlang/paraglide-js": "^2.23.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
