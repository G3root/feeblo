{
  "extends": "@feeblo/config/tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "types": [],
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  // `test/**/*` is included on purpose. Without it the specs under `test/` were
  // compiled by nothing: `pnpm check` runs `tsc --noEmit` per package, and a
  // file outside `include` is invisible to it.
  "include": ["src/**/*", "test/**/*"]
}
