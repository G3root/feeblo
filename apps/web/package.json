{
  "name": "@feeblo/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm build:paraglide && pnpm build:widget && pnpm build:app",
    "build:app": "dotenvx run -f ../../.env -- vite build",
    "build:paraglide": "paraglide-js compile --project ../../project.inlang --outdir ./src/paraglide --emit-ts-declarations",
    "build:widget": "pnpm --filter @feeblo/feedback-widget build:iframe",
    "dev": "dotenvx run -f ../../.env -- vite dev --port 3001",
    "dev:bare": "vite dev",
    "preview": "vite preview",
    "start": "node server.mjs",
    "generate-types": "wrangler types",
    "test": "vitest run",
    "machine-translate": "inlang machine translate --project ../../project.inlang",
    "typecheck": "tsrs --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@dnd-kit/abstract": "^0.5.1",
    "@dnd-kit/dom": "^0.5.1",
    "@dnd-kit/react": "^0.5.1",
    "@effect/atom-react": "catalog:",
    "@egoist/tailwindcss-icons": "^1.9.2",
    "@feeblo/auth": "workspace:*",
    "@feeblo/domain": "workspace:*",
    "@feeblo/domain-contracts": "workspace:*",
    "@feeblo/feedback-widget": "workspace:*",
    "@feeblo/id": "workspace:*",
    "@feeblo/permissions": "workspace:*",
    "@feeblo/post-ui": "workspace:*",
    "@feeblo/public-feature-board": "workspace:*",
    "@feeblo/rpc-client": "workspace:*",
    "@feeblo/ui": "workspace:*",
    "@feeblo/utils": "workspace:*",
    "@feeblo/web-shared": "workspace:*",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.2.3",
    "@hugeicons/react": "^1.1.9",
    "@tanstack/query-db-collection": "catalog:",
    "@tanstack/react-db": "catalog:",
    "@tanstack/react-form": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-start": "catalog:",
    "@tanstack/react-store": "^0.11.0",
    "@tanstack/react-virtual": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@xstate/store": "^4.3.0",
    "@xstate/store-react": "^2.1.0",
    "class-variance-authority": "catalog:",
    "effect": "catalog:",
    "posthog-js": "catalog:",
    "react": "catalog:",
    "react-avatar-editor": "^16.0.0",
    "react-dom": "catalog:",
    "wrangler": "^4.131.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.9",
    "@cloudflare/workers-types": "catalog:",
    "@feeblo/config": "workspace:*",
    "@inlang/cli": "^3.3.0",
    "@inlang/paraglide-js": "^2.23.1",
    "@sentry/vite-plugin": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "srvx": "^0.11.21",
    "tailwindcss": "catalog:",
    "tsrs": "catalog:",
    "vitest": "catalog:"
  }
}
