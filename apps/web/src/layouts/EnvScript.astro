---
interface Props {
  organizationId?: string;
  widgetConfig?: {
    mode: "feedback" | "updates" | "hub";
    modules: Array<"feedback" | "updates">;
  };
}

const { organizationId, widgetConfig } = Astro.props;

import { getPublicEnvServer } from "../dashboard/lib/server-runtime-public-env";

const publicEnv = getPublicEnvServer();
---

<script is:inline define:vars={{ publicEnv, organizationId, widgetConfig }}>
  window.global = window.global || {};
  window.global.__ENV = {
    ...publicEnv,
    ...(organizationId ? { organizationId } : {}),
    ...(widgetConfig ? { widgetConfig } : {}),
  };
</script>
