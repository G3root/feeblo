---
import "../styles/global.css";

import { getSecret } from "astro:env/server";
import { serializeJsonLd, type JsonLdNode } from "@feeblo/web-shared/json-ld";
import {
  apiPreconnectOrigins,
  getServerRuntimePublicEnv,
} from "../dashboard/lib/server-runtime-public-env";
import CommonHead from "./CommonHead.astro";
import EnvScript from "./EnvScript.astro";
import ThemeScript from "./ThemeScript.astro";

interface Props {
  canonicalUrl?: string;
  changelogVisibility?: "PUBLIC" | "HIDDEN";
  description?: string;
  /** JSON-LD nodes (schema.org) rendered as structured-data scripts in the head. */
  jsonLd?: ReadonlyArray<JsonLdNode>;
  noIndex?: boolean;
  organizationId: string;
  siteName: string;
  subdomain: string;
  title?: string;
}

const {
  changelogVisibility,
  description,
  jsonLd,
  title = "feeblo",
  organizationId,
  siteName,
  subdomain,
} = Astro.props;
const noIndex = Boolean(getSecret("NO_INDEX")) || Boolean(Astro.props.noIndex);
// Public board requests are internally rewritten to `/s/...` by the
// middleware; the canonical URL must stay on the original public path the
// visitor (and every crawler) sees. The middleware stashes that path in
// locals before rewriting (`Astro.url` reflects the rewrite target).
const canonicalUrl =
  Astro.props.canonicalUrl ??
  new URL(Astro.locals.publicPath ?? Astro.url.pathname, Astro.url.origin).toString();
const ogImageUrl = new URL("/og-image", getServerRuntimePublicEnv().apiUrl);
ogImageUrl.searchParams.set("name", siteName);
ogImageUrl.searchParams.set("site", subdomain);
---

<!doctype html>
<html lang="en">
  <CommonHead
    canonicalUrl={canonicalUrl}
    description={description}
    title={title}
    noIndex={noIndex}
    ogImageUrl={ogImageUrl.toString()}
    preconnectOrigins={apiPreconnectOrigins()}
  />
  {
    jsonLd?.map((node) => (
      <script
        type="application/ld+json"
        set:html={serializeJsonLd(node)}
        is:inline
      />
    ))
  }
  {
    changelogVisibility === "PUBLIC" && (
      <link
        href="/changelog/rss.xml"
        rel="alternate"
        title={`${siteName} changelog`}
        type="application/rss+xml"
      />
    )
  }
  <EnvScript organizationId={organizationId} />
  <ThemeScript />
  <body>
    <slot />
  </body>
</html>
