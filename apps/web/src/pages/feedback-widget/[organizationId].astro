---
import { WidgetApp } from "@feeblo/feedback-widget";
import { isSupportedLocale } from "@feeblo/feedback-widget/config";
import Layout from "../../layouts/FeedbackWidgetLayout.astro";

export const prerender = false;

const { organizationId } = Astro.params;

if (!organizationId) {
  return new Response("Not found", { status: 404 });
}

const theme = Astro.url.searchParams.get("theme") ?? "light";
const requestedLocale = Astro.url.searchParams.get("locale");
const locale = isSupportedLocale(requestedLocale) ? requestedLocale : "en";
const requestedMode = Astro.url.searchParams.get("mode");
const mode =
  requestedMode === "updates" || requestedMode === "hub"
    ? requestedMode
    : "feedback";
const requestedModules = (Astro.url.searchParams.get("modules") ?? "")
  .split(",")
  .filter(
    (module): module is "feedback" | "updates" =>
      module === "feedback" || module === "updates",
  );
const modules: Array<"feedback" | "updates"> =
  mode === "hub"
    ? [
        ...new Set(
          requestedModules.length > 0
            ? requestedModules
            : (["feedback", "updates"] as const),
        ),
      ]
    : [mode];
---

<Layout
  organizationId={organizationId}
  theme={theme}
  locale={locale}
  widgetConfig={{ mode, modules }}
>
  <WidgetApp client:only="solid-js" />

  <script is:inline>
    function notifyHeight() {
      requestAnimationFrame(() => {
        const height = document.documentElement.scrollHeight;
        if (window.parent !== window) {
          window.parent.postMessage(
            { event: "PAGE_HEIGHT", data: { height } },
            "*",
          );
        }
      });
    }

    window.addEventListener("load", notifyHeight);
    window.addEventListener("resize", notifyHeight);
  </script>
</Layout>
