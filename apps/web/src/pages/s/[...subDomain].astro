---
import type { TChangelog } from "@feeblo/domain/changelog/schema";
import type { TPost } from "@feeblo/domain/post/schema";
import type { TSite } from "@feeblo/domain/site/schema";
import { PublicBoardApp } from "@feeblo/public-feature-board";
import {
  changelogJsonLd,
  postJsonLd,
  websiteJsonLd,
  type JsonLdNode,
} from "@feeblo/web-shared/json-ld";
import PublicBoardLayout from "../../layouts/PublicBoardLayout.astro";

export const prerender = false;

/**
 * Fetch the content behind the current public path for per-page metadata and
 * JSON-LD. Only detail pages carry per-page content; every other route keeps
 * the site-level defaults. Any RPC failure (including a missing or hidden
 * entity) falls back to the defaults instead of breaking the page — the SPA
 * renders its own not-found state.
 */
async function resolvePageContent(
  publicPath: string,
  site: TSite
): Promise<{ post: TPost | null; changelog: TChangelog | null }> {
  const postMatch = /^\/p\/([^/]+)$/.exec(publicPath);
  const changelogMatch = /^\/changelog\/([^/]+)$/.exec(publicPath);

  if (!postMatch && !changelogMatch) {
    return { post: null, changelog: null };
  }

  try {
    // Lazy-load the Effect RPC runtime so it stays out of the worker's
    // startup module graph (same pattern as rss.xml.ts).
    const { fetchRpcServer } = await import("~/lib/runtime-server");

    if (postMatch) {
      const post = await fetchRpcServer((rpc) =>
        rpc.PostGetPublic({
          organizationId: site.organizationId,
          // SAFETY: The capture group matched, so the index is present.
          slug: postMatch[1]!,
        })
      );
      return { post, changelog: null };
    }

    if (site.changelogVisibility !== "PUBLIC") {
      return { post: null, changelog: null };
    }

    // SAFETY: `postMatch` is null here, so `changelogMatch` matched.
    const changelogSlug = changelogMatch![1]!;
    // Changelog lists are bounded (published entries only), so resolving a
    // single entry through the list is acceptable per request.
    const entries = await fetchRpcServer((rpc) =>
      rpc.ChangelogListPublic({ organizationId: site.organizationId })
    );
    return {
      post: null,
      changelog: entries.find((entry) => entry.slug === changelogSlug) ?? null,
    };
  } catch {
    return { post: null, changelog: null };
  }
}

const { publicPath, subdomain, site } = Astro.locals;

if (!subdomain) {
  throw new Error("Subdomain is required");
}

if (!site) {
  return new Response("Site not found", { status: 404 });
}

if (publicPath === undefined) {
  return new Response("Public path not resolved", { status: 500 });
}

const siteUrl = new URL("/", Astro.url.origin).toString();
const pageUrl = new URL(publicPath, Astro.url.origin).toString();
const jsonLd: JsonLdNode[] = [
  websiteJsonLd({ name: site.name, url: siteUrl }),
];
let pageTitle = `${site.name} — Feedback and roadmap`;
let pageDescription = `Share feedback, follow the roadmap, and read product updates from ${site.name}.`;

// The board is a client-rendered SPA; this server-resolved metadata gives
// crawlers per-page titles, descriptions, and structured data.
const { post, changelog } = await resolvePageContent(publicPath, site);

if (post) {
  pageTitle = `${post.title} — ${site.name}`;
  pageDescription = post.excerpt;
  jsonLd.push(
    postJsonLd({
      headline: post.title,
      description: post.excerpt,
      url: pageUrl,
      datePublished: post.createdAt,
      dateModified: post.updatedAt,
      authorName: post.user.name,
    })
  );
} else if (changelog) {
  pageTitle = `${changelog.title} — ${site.name} changelog`;
  pageDescription = changelog.excerpt;
  jsonLd.push(
    changelogJsonLd({
      headline: changelog.title,
      description: changelog.excerpt,
      url: pageUrl,
      datePublished: changelog.publishedAt ?? changelog.createdAt,
      dateModified: changelog.updatedAt,
      authorName: changelog.user.name,
    })
  );
}
---

<PublicBoardLayout
  changelogVisibility={site.changelogVisibility}
  description={pageDescription}
  jsonLd={jsonLd}
  noIndex={site.noIndex}
  organizationId={site.organizationId}
  siteName={site.name}
  subdomain={site.subdomain}
  title={pageTitle}
>
  <main>
    <PublicBoardApp client:only="react" site={site} />
  </main>
</PublicBoardLayout>
