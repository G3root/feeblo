{
  // Reviewed-and-accepted dependency note for `socket/low-supply-chain-score`.
  //
  // `posthog-js` is the official PostHog product-analytics SDK and is exactly
  // the package we intend to ship (no typosquat / impostor). It is healthy on
  // the other Socket axes — vulnerability 100, license 100, maintenance 100 —
  // and its low "supply chain" score comes from its install-time telemetry
  // script, not from install scripts, native/obfuscated code, or network/
  // filesystem/shell access.
  //
  // Socket's supply-chain score for posthog-js regressed below 50 at v1.411
  // and no current release scores >=50, so raising the version cannot clear
  // the threshold and there is no drop-in alternative (swapping it would
  // replace the product's analytics backend). We have reviewed and accepted
  // it, and the rule's documented remedy for an accepted dependency is to
  // lower `supplyChain.minScore`. The rule stays ENABLED and still flags any
  // dependency scoring below 31; only this one accepted dependency passes.
  "supplyChain": {
    "minScore": 31
  }
}
