{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  // `typecheck` is cached and reads `node_modules` through every package's
  // imports, so the resolved dependency versions have to be part of its hash.
  // They are not by default: appending a line to `pnpm-lock.yaml` leaves every
  // typecheck task reporting `cache hit, replaying logs`, and a package whose
  // types no longer compile replays a green result from before the bump. That
  // is the same hazard the `//#toolchain` and `//#knip` comments below describe
  // and solve by not caching at all; typecheck is worth caching, so the
  // lockfile is named as a global dependency instead. A source-only change
  // still hits the cache; a dependency bump now misses once, which is the point.
  "globalDependencies": ["pnpm-lock.yaml"],
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck", "build:paraglide"],
      "outputs": []
    },
    // A single whole-repo task, and deliberately so. Splitting it into one task
    // per package was tried and measured at ~30 minutes of wall time against
    // ~130s here: `typeAware` builds a TypeScript program per invocation, and
    // the programs overlap, so twenty of them resident at once (10 concurrent,
    // each pulling its dependency graph) spent 48 minutes of system time
    // thrashing a 16 GB machine to do less work than this one process does with
    // a single 2.3 GB program. The caching granularity is not worth 6x the
    // runtime; if this ever needs to get faster, the lever is the type-aware
    // pass itself, not the task layout. See `docs/adr/0005`.
    "//#lint": {
      "outputs": []
    },
    // Reads the manifests and `pnpm-workspace.yaml`, so it hashes the whole repo
    // and needs no outputs: see `check-toolchain.ts`.
    //
    // Not cached on purpose: its patch check reads installed versions from
    // `node_modules`, which are not a tracked input, so a replayed success could
    // describe an install that no longer exists. It takes milliseconds.
    "//#toolchain": {
      "cache": false,
      "outputs": []
    },
    // Finds unused files, dependencies and exports. It resolves every import
    // through `node_modules` and reads the manifests and the workspace file, so
    // it hashes the whole repository and produces no output.
    //
    // The three `build:paraglide` dependencies are ordering, not work: the
    // generated `src/paraglide` directories ignore themselves through a
    // `.gitignore` Paraglide writes into them, so Knip must not start reading
    // one before that file exists. Running them concurrently (they are already
    // in the graph for `typecheck`) let Knip enumerate half-written generated
    // files as project files and report every unused runtime export on CI.
    //
    // Not cached: the report depends on installed packages and on generated
    // files that are not tracked inputs, so a replayed success could describe
    // a tree that no longer exists. It takes ~12s.
    //
    // The issue types pinned to `warn` in `knip.config.ts` are printed but do
    // not fail the run; the `error` ones are the types that are clean today.
    "//#knip": {
      "dependsOn": [
        "@feeblo/web#build:paraglide",
        "@feeblo/post-ui#build:paraglide",
        "@feeblo/public-feature-board#build:paraglide"
      ],
      "cache": false,
      "outputs": []
    },
    "check": {
      "dependsOn": ["typecheck", "//#lint", "//#toolchain", "//#knip"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build", "^build:paraglide", "^build:iframe"],
      "env": ["APP_ROOT_DOMAIN", "APP_URL", "API_URL", "CLOUDFLARE_ADAPTER"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "build:iframe": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["../../apps/web/public/widget/**"]
    },
    "build:paraglide": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/project.inlang/**",
        "$TURBO_ROOT$/messages/**"
      ],
      "outputs": ["src/paraglide/**"]
    },
    "test": {
      "dependsOn": ["build:paraglide"],
      "outputs": [],
      "cache": false
    },
    // `@feeblo/post-ui` and `@feeblo/public-feature-board` both have a test that
    // asserts on translated copy, and their tests resolve `src/paraglide` at
    // import time, so they keep the dependency above. `@feeblo/web` does not:
    // its tests are two files that never touch paraglide, and its own
    // `vitest.config.ts` deliberately does not load the app config that would
    // pull it in. Leaving the dependency in place made a two-second test suite
    // wait ~30s for a compile whose output it never reads.
    "@feeblo/web#test": {
      "dependsOn": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:push": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false,
      "persistent": true
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    },
    "db:start": {
      "cache": false,
      "persistent": true
    },
    "db:stop": {
      "cache": false
    },
    "db:watch": {
      "cache": false,
      "persistent": true
    },
    "db:down": {
      "cache": false
    },
    "deploy": {
      "cache": false
    },
    "destroy": {
      "cache": false
    }
  }
}
