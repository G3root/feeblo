{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "^build:paraglide"],
      "env": ["APP_ROOT_DOMAIN", "APP_URL", "API_URL", "CLOUDFLARE_ADAPTER"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "build:paraglide": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/project.inlang/**",
        "$TURBO_ROOT$/messages/**"
      ],
      "outputs": ["src/paraglide/**"]
    },
    "test": {
      "dependsOn": ["build:paraglide"],
      "outputs": [],
      "cache": false
    },
    "check-types": {
      "dependsOn": ["build:paraglide", "^build:paraglide"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:push": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false,
      "persistent": true
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    },
    "db:start": {
      "cache": false,
      "persistent": true
    },
    "db:stop": {
      "cache": false
    },
    "db:watch": {
      "cache": false,
      "persistent": true
    },
    "db:down": {
      "cache": false
    },
    "deploy": {
      "cache": false
    },
    "destroy": {
      "cache": false
    }
  }
}
