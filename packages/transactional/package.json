{
  "name": "@feeblo/transactional",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./mailer": {
      "default": "./src/mailer.ts"
    },
    "./mailer/test": {
      "default": "./src/test-mailer.ts"
    },
    "./templates/*": {
      "default": "./src/templates/*.tsx"
    }
  },
  "scripts": {
    "check-types": "tsc -p tsconfig.json --noEmit",
    "email:dev": "email dev --dir ./src/templates --port 3005",
    "email:export": "email export",
    "email:start": "email start",
    "test": "vitest run"
  },
  "dependencies": {
    "@feeblo/config": "workspace:*",
    "effect": "catalog:",
    "nodemailer": "^8.0.2",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-email": "^6.9.1"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@react-email/ui": "6.9.2",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
