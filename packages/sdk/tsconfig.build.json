{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "rootDir": "./src",
    "outDir": "dist",
    "incremental": false,
    "tsBuildInfoFile": "./.tsbuildinfo.build"
  },
  "include": ["src/index.ts", "src/react/index.ts"],
  "exclude": ["src/preview.ts"]
}
