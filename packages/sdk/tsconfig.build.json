{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "rootDir": "./src",
    "outDir": "dist",
    // Vite empties dist/ after any previous build; without this, tsc's
    // incremental state claims the removed declarations are up-to-date.
    "incremental": false
  },
  "include": ["src/index.ts"],
  "exclude": ["src/preview.ts"]
}
