{
  "extends": "@feeblo/config/tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "types": [],
    // This config is for typechecking and the editor. `tsconfig.build.json`
    // owns `rootDir`/`outDir`/`declaration` for the real emit.
    "noEmit": true,
    "strictNullChecks": true
  },
  // `test/**/*` is included on purpose. Without it the 10 spec files under
  // `test/` were compiled by nothing: `pnpm check` runs `tsc --noEmit` per
  // package, and a test file outside `include` is invisible to it. The package
  // ships to npm, so its tests should not be the one thing tsc never reads.
  "include": ["src/**/*", "test/**/*"]
}
