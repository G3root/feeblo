{
  "name": "@feeblo/sdk",
  "version": "0.0.1",
  "private": false,
  "description": "Embeddable feedback widget SDK for Feeblo.",
  "keywords": [
    "changelog",
    "embed",
    "feature-requests",
    "feeblo",
    "feedback",
    "sdk",
    "widget"
  ],
  "homepage": "https://github.com/G3root/feeblo/tree/main/packages/sdk",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/G3root/feeblo.git",
    "directory": "packages/sdk"
  },
  "files": [
    "dist/**",
    "README.md"
  ],
  "type": "module",
  "sideEffects": true,
  "main": "./dist/feeblo-sdk.umd.cjs",
  "module": "./dist/feeblo-sdk.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/feeblo-sdk.js",
      "require": "./dist/feeblo-sdk.umd.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.umd.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.react.config.ts && tsc -p tsconfig.build.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check-types": "tsc --noEmit",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src"
  },
  "dependencies": {},
  "devDependencies": {
    "@feeblo/config": "workspace:*",
    "@floating-ui/dom": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/browser-playwright": "^4.1.10",
    "happy-dom": "^20.10.6",
    "playwright": "^1.56.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-react": "^2.2.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
