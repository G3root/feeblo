{
  "extends": "@feeblo/config/tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "types": [],
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    // Vite owns the build output; this config is for typechecking and the
    // editor, so it must not declare `outDir`/`declaration` without `rootDir`.
    "noEmit": true,
    "strictNullChecks": true
  },
  "include": ["src/**/*"]
}
