# [[DATABASE]]
DATABASE_URL="postgres://feeblo:password@127.0.0.1:54323/feeblo"

# [[REDIS]]
# OPTIONAL: Redis URL (redis://host:port, optionally with username/password and
# db index) used to share the rate-limiter store across server instances. Set
# this when running more than one server; otherwise the rate limiter falls back
# to an in-memory store. Example:
#   REDIS_URL="redis://:password@localhost:63799/0"
# Docker Compose: the dev stack (docker/docker-compose.dev.yml) exposes Redis on
# 127.0.0.1:63799, so point at it with:
#   REDIS_URL="redis://127.0.0.1:63799/0"
# Inside the production compose network the server already defaults to
# redis://redis:6379/0 (service name `redis`).
#
# REQUIRED IN PRODUCTION: a per-instance in-memory limiter multiplies every
# public rate limit by the number of replicas, and startup fails without this
# URL in production. Dev/test fall back to an in-memory store when unset.
REDIS_URL="redis://127.0.0.1:63799/0"

# [[SMTP]]
# OPTIONAL: Defines the transport to use for sending emails. Available options: smtp-auth (default) | smtp-api | resend
SMTP_TRANSPORT="smtp-auth"
# OPTIONAL: Defines the host to use for sending emails.
SMTP_HOST="127.0.0.1"
# OPTIONAL: Defines the port to use for sending emails.
SMTP_PORT=1025
# OPTIONAL: Defines the username to use with the SMTP server.
SMTP_USERNAME="feeblo"
# OPTIONAL: Defines the password to use with the SMTP server.
SMTP_PASSWORD="password"
# OPTIONAL: Defines whether to force the use of TLS.
SMTP_SECURE=
# OPTIONAL: if this is true and SMTP_SECURE is false then TLS is not used even if the server supports STARTTLS extension
SMTP_UNSAFE_IGNORE_TLS=
# REQUIRED: Defines the sender name to use for the from address.
SMTP_FROM_NAME="Feeblo"
# REQUIRED: Defines the email address to use as the from address.
SMTP_FROM_ADDRESS="noreply@feeblo.com"
# OPTIONAL: Sender address for personal lifecycle emails (user onboarding and
# user feedback). Falls back to SMTP_FROM_ADDRESS when unset.
SMTP_PERSONAL_FROM_ADDRESS=""
# OPTIONAL: Defines the service for node-mailer
SMTP_SERVICE=

# [[EMAIL PROVIDER FEEDBACK]]
# OPTIONAL: The token alone activates the Amazon SES email-feedback webhook
# used to track deliveries, bounces, and complaints. Self-hosted deployments
# that do not use SES feedback can leave it empty; the webhook route then
# stays inert. When enabled, subscribe the SNS topic to
# <API_URL>/email-provider/ses/<EMAIL_PROVIDER_WEBHOOK_TOKEN>. The token must
# not fall back to AUTH_ENCRYPTION_KEY; generate one with:
#   openssl rand -hex 32
# Callers that can set headers may instead POST to <API_URL>/email-provider/ses
# with an `x-feeblo-webhook-token` header, which keeps the token out of
# access logs and proxies. Rotate the token if it may have been logged.
EMAIL_PROVIDER_WEBHOOK_TOKEN=
# OPTIONAL: ARN of the SNS topic that delivers SES email feedback to the
# webhook. Its only role is source filtering: with the token enabled, the
# webhook checks that each message's signed TopicArn matches this ARN and
# rejects messages from any other topic. Set it whenever the token is set;
# without it a message's origin cannot be verified, so the webhook rejects
# requests rather than trusting an unverifiable source.
EMAIL_PROVIDER_SNS_TOPIC_ARN=
# OPTIONAL: Durable email safety controls.
EMAIL_OUTBOX_GLOBAL_DELIVERY_PAUSED=false
EMAIL_OUTBOX_MAX_CONCURRENT_SENDS=10
EMAIL_OUTBOX_MONTHLY_SEND_LIMIT=100000
EMAIL_OUTBOX_ESTIMATED_SEND_COST_MICROS=100
EMAIL_OUTBOX_PAUSED_WORKSPACE_IDS=

# [[AUTH]]
# REQUIRED: At-rest encryption key for auth and email-subscription tokens.
# When INTEGRATION_ENCRYPTION_KEY is unset it also encrypts integration
# credentials, so it must be at least 32 bytes. Generate with:
#   openssl rand -hex 32
# The server refuses to start in production when this is shorter than 32
# bytes, so the placeholder below is development-only.
AUTH_ENCRYPTION_KEY="secret"
# OPTIONAL: Comma-separated browser origins allowed to call the API
# (better-auth trustedOrigins). Defaults to APP_URL, API_URL, and
# *.localhost:3001 when unset. In production, public board subdomains need a
# wildcard for the root domain, e.g. *.feeblo.com (scheme-less patterns match
# both http and https hosts). The same list is honored by the API CORS and
# CSRF origin checks, so an added origin is trusted end to end.
AUTH_TRUSTED_ORIGINS=
# OPTIONAL: Comma-separated allow-list for sign-up. Each entry is a glob where
# `*` matches any run of characters, matched against the full email address
# case-insensitively, e.g. `*@acme.com,founder@example.org`. When set, every
# address that does not match is rejected with EMAIL_BLOCKED. Unset means any
# address may sign up.
ALLOWED_EMAILS=
# OPTIONAL: Set to false to close sign-up on a private instance. Defaults to true.
AUTH_SIGN_UP_ENABLED=true
# OPTIONAL: Require members to verify their email before signing in. Defaults to
# true. Turning this off lets an unverified address reach the dashboard.
AUTH_EMAIL_VERIFICATION_REQUIRED=true
# OPTIONAL: Sign the new member in immediately after sign-up instead of sending
# them to the verification step. Defaults to false, which is why the default
# flow needs SMTP configured to be usable.
AUTH_AUTO_SIGN_IN_AFTER_SIGN_UP=false
# OPTIONAL: Cloudflare Turnstile captcha. Both halves are needed: the secret is
# verified server-side against sign-up requests, the site key is handed to the
# browser. Leaving either unset disables the captcha entirely.
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# [[SOCIAL AUTH]]
# GitHub/Google OAuth client credentials. Set these to the values registered
# with the real providers (production) or the local emulator's oauth_apps /
# oauth_clients (development, see emulate.config.yaml).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# OPTIONAL: When set, the matching provider above is pointed at the local
# OAuth emulator (vercel-labs/emulate) instead of the real provider; the
# built-in better-auth provider is used when unset. Example values:
#   GITHUB_EMULATOR_URL=http://localhost:4000
#   GOOGLE_EMULATOR_URL=http://localhost:4001
# or with portless: https://github.emulate.localhost / https://google.emulate.localhost
GITHUB_EMULATOR_URL=
GOOGLE_EMULATOR_URL=

# [[APP]]
APP_URL=http://localhost:3001
API_URL=http://localhost:3000
APP_ROOT_DOMAIN=localhost:3001
APP_RELEASE=dev
# OPTIONAL: Set to any truthy value to prevent search engines from indexing the site (e.g. for staging)
NO_INDEX=
# OPTIONAL: The port the API listens on. Defaults to 3000, but the published
# Docker image pins it to 8080 and docker-compose.yml both publishes and listens
# on that port. Leave this commented out for the compose stack: setting it here
# changes the port the container listens on while the published mapping stays
# 8080, so the healthcheck and the reverse proxy stop reaching the server.
# Only uncomment it when running the server process directly.
# SERVER_PORT=3000
# OPTIONAL: Trust the client-IP forwarding headers (X-Forwarded-For and friends)
# on every request. Defaults to false, which is correct when the API is exposed
# directly. Set it to true only behind a proxy you control that overwrites those
# headers; otherwise a client can spoof its own address and defeat the per-IP
# public rate limits.
TRUST_PROXY_HEADERS=false
# OPTIONAL: Comma-separated IP addresses and CIDRs of proxies whose forwarding
# headers may be believed, e.g. `10.0.0.0/8,2001:db8::/32`. This is the narrower
# alternative to TRUST_PROXY_HEADERS above. An entry that is not a valid IP or
# CIDR makes the server refuse to start rather than fall back silently.
TRUSTED_PROXY_IPS=
# BUILD-TIME ONLY: Set to true to build apps/web for Cloudflare Workers instead
# of the Node server. The published web image and the e2e build both set it to
# false, and nothing in this repository sets it to true — the Cloudflare deploy
# environment supplies it. It is read by vite.config.ts and has no effect at
# runtime.
CLOUDFLARE_ADAPTER=false

# [[INTEGRATIONS]]
# Key used to encrypt integration credentials (webhook endpoint URLs and
# signing secrets) at rest. Must be at least 32 bytes, otherwise webhook
# create/update/rotate fails with "Webhook credentials could not be
# encrypted". Generate with:
#   openssl rand -hex 32
# Defaults to AUTH_ENCRYPTION_KEY when unset, so a single shared secret can
# cover both (that key must then also be at least 32 bytes).
INTEGRATION_ENCRYPTION_KEY=
# OPTIONAL: Allow outbound webhook deliveries to private-network endpoints in
# development only. Never enable this in production.
INTEGRATION_ALLOW_PRIVATE_NETWORK=false

# [[SLACK]]
# Slack app credentials (see integrations/slack/slack-app-manifest.yaml).
# Leave empty to disable the Slack integration.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Request-signing secret printed on the app's Basic Information page.
SLACK_SIGNING_SECRET=
# OPTIONAL: OAuth redirect URL. Defaults to <API_URL>/slack/oauth/callback.
SLACK_OAUTH_REDIRECT_URL=

# [[DISCORD]]
# Discord app credentials. Create a bot at discord.com/developers/applications
# (Application -> Bot -> Reset Token; General Information -> Public Key). The
# OAuth redirect URL must be registered under OAuth2 -> Redirects.
# Leave empty to disable the Discord integration.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Application-wide bot token (the same token serves every guild install).
DISCORD_BOT_TOKEN=
# Interaction public key (64 hex chars) used to verify request signatures.
DISCORD_PUBLIC_KEY=
# OPTIONAL: OAuth redirect URL. Defaults to <API_URL>/discord/oauth/callback.
DISCORD_OAUTH_REDIRECT_URL=

# [[GITHUB APP INTEGRATION]]
# These settings power the two-way GitHub issue integration and are separate
# from GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET under SOCIAL AUTH, which are
# used only for signing users into Feeblo.
#
# Create a GitHub App under GitHub Settings -> Developer settings -> GitHub
# Apps. Give it repository permissions "Issues: Read and write" and
# "Metadata: Read", subscribe it to the Issues event, and enable
# "Request user authorization (OAuth) during installation". Leave every
# value below empty to disable the GitHub integration.
#
# REQUIRED: Numeric App ID shown on the GitHub App's General page. This is not
# the OAuth Client ID.
GITHUB_INTEGRATION_APP_ID=
# REQUIRED: URL-friendly app name from the public installation URL. For
# https://github.com/apps/feeblo, the slug is "feeblo".
GITHUB_INTEGRATION_APP_SLUG=
# REQUIRED: Client ID and client secret from the GitHub App's General page.
# They are used only during installation to verify that the current installer
# can access the selected GitHub App installation. The temporary user token is
# discarded and is never stored.
GITHUB_INTEGRATION_CLIENT_ID=
GITHUB_INTEGRATION_CLIENT_SECRET=
# REQUIRED: PEM private key generated from the GitHub App's Private keys
# section. Preserve the complete BEGIN/END lines and line breaks. In a secret
# manager, store the PEM as a multiline secret rather than committing the
# downloaded .pem file.
GITHUB_INTEGRATION_PRIVATE_KEY=
# REQUIRED: Random webhook secret configured identically on the GitHub App's
# General page. GitHub signs the global App webhook with this value.
# Generate one with: openssl rand -hex 32
# Also register the fixed Feeblo endpoints in the GitHub App: the callback URL
# <API_URL>/github/app/installations/callback and the webhook URL
# <API_URL>/github/app/webhooks. Feeblo mounts both paths itself; there are no
# override variables for them.
GITHUB_INTEGRATION_WEBHOOK_SECRET=

# [[BILLING]]
# OPTIONAL: Enables Polar checkout, customer portal, and signed webhooks when
# both credentials are configured. Use sandbox while testing.
POLAR_MODE=sandbox
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=

# [[SENTRY]]
# OPTIONAL: Enables server error tracking, tracing, logs, and metrics when configured.
SENTRY_DSN=
# OPTIONAL: Sentry environment label. Defaults to NODE_ENV; set to staging while NODE_ENV remains production.
SENTRY_ENVIRONMENT=
# OPTIONAL: Percentage of transactions to trace (0.0–1.0). Defaults to 0.1.
SENTRY_TRACES_SAMPLE_RATE=0.1

# [[POST_EMBEDDINGS]]
# OPTIONAL: Enables AI-powered post embeddings and semantic suggestions.
# The API must implement the OpenAI embeddings endpoint.
EMBEDDING_API_KEY=
# OPTIONAL: Defaults to text-embedding-3-small.
EMBEDDING_MODEL=text-embedding-3-small
# OPTIONAL: Defaults to 1536. Run db:configure-embeddings when changing this.
EMBEDDING_DIMENSIONS=1536
# OPTIONAL: Override for OpenAI-compatible providers such as Hugging Face or Ollama.
EMBEDDING_API_URL=
# OPTIONAL: How long a single embedding request may take before it fails. Accepts
# an Effect duration such as `10 seconds`, `500 millis`, or a plain number of
# milliseconds. Defaults to 10 seconds.
EMBEDDING_TIMEOUT=10 seconds

# [[MEDIA_UPLOAD]]

MEDIA_UPLOAD_REGION="us-east-1" # value should be 'auto' while using r2
MEDIA_UPLOAD_ENDPOINT="http://127.0.0.1:9002"
MEDIA_UPLOAD_ACCESS_KEY_ID="feeblo"
MEDIA_UPLOAD_SECRET_ACCESS_KEY="password"
MEDIA_PUBLIC_BUCKET_NAME="feeblo-media-public"
# OPTIONAL: Public base URL for uploaded media, used when the bucket is served
# from somewhere other than MEDIA_UPLOAD_ENDPOINT — a CDN, a custom domain, or a
# Cloudflare R2 public bucket. Unset means URLs are built from the endpoint.
MEDIA_PUBLIC_BASE_URL=

# [[POSTHOG]]
# OPTIONAL: PostHog project API key. When omitted, all analytics is disabled.
POSTHOG_KEY=
# OPTIONAL: PostHog instance host. Defaults to https://us.i.posthog.com
POSTHOG_HOST=

# [[SUBDOMAIN_VALIDATION]]
# OPTIONAL: Comma-separated profanity words appended to the bundled dictionary.
PROFANITY_EXTRA_WORDS=
# OPTIONAL: Comma-separated subdomain names to reserve in addition to the
# built-in platform names (api, app, www, admin, forum, roadmap, changelog, …).
# The list is additive: it can reserve extra names but cannot release a built-in
# one.
RESERVED_SUBDOMAINS=
