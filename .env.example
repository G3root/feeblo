# [[DATABASE]]
DATABASE_URL="postgres://feeblo:password@127.0.0.1:54323/feeblo"

# [[SMTP]]
# OPTIONAL: Defines the transport to use for sending emails. Available options: smtp-auth (default) | smtp-api | resend
SMTP_TRANSPORT="smtp-auth"
# OPTIONAL: Defines the host to use for sending emails.
SMTP_HOST="127.0.0.1"
# OPTIONAL: Defines the port to use for sending emails.
SMTP_PORT=1025
# OPTIONAL: Defines the username to use with the SMTP server.
SMTP_USERNAME="feeblo"
# OPTIONAL: Defines the password to use with the SMTP server.
SMTP_PASSWORD="password"
# OPTIONAL: Defines whether to force the use of TLS.
SMTP_SECURE=
# OPTIONAL: if this is true and SMTP_SECURE is false then TLS is not used even if the server supports STARTTLS extension
SMTP_UNSAFE_IGNORE_TLS=
# REQUIRED: Defines the sender name to use for the from address.
SMTP_FROM_NAME="Feeblo"
# REQUIRED: Defines the email address to use as the from address.
SMTP_FROM_ADDRESS="noreply@feeblo.com"
# OPTIONAL: Defines the service for node-mailer
SMTP_SERVICE=

# [[EMAIL_NOTIFICATIONS]]
# Transactional email outbox (status-change notifications to post subscribers).
# All values optional with safe defaults; unset values use the defaults below.
# OPTIONAL: Maximum notification emails a single recipient receives per 24h.
# Over-cap recipients are held and re-attempted later, never dropped.
# Defaults to 10.
EMAIL_DAILY_CAP_PER_RECIPIENT=
# OPTIONAL: Coalescing window for per-post notifications — status changes on
# the same post inside one window collapse into a single email.
# Accepts any Effect duration string (e.g. "15 minutes", "1 hour"). Defaults to
# "15 minutes".
EMAIL_DIGEST_WINDOW=
# OPTIONAL: Maximum claim cycles before an undeliverable event dead-letters
# (visible in the workspace Emails settings page). Defaults to 8.
EMAIL_MAX_ATTEMPTS=
# OPTIONAL: Shared provider send budget in sends/second. The dispatcher
# consumes one token per send and backs off the whole batch when exhausted.
# Fail-open: an unavailable limiter never blocks delivery. Defaults to 10.
EMAIL_PROVIDER_SENDS_PER_SECOND=
# OPTIONAL: Shared secret for the bounce/complaint webhook endpoint
# (POST /api/email/webhooks/:provider). When set, requests must carry
# `X-Feeblo-Signature: sha256=<hmac of the raw body>`. When unset (SMTP-only
# dev), requests are accepted without a signature.
EMAIL_WEBHOOK_SECRET=
# OPTIONAL: Log an error (captured by Sentry when enabled) when failed email
# events in the last 24h reach this count (checked on every /health call).
# Defaults to 5.
EMAIL_CONSECUTIVE_FAILURES_ALERT_THRESHOLD=
# OPTIONAL: HS256 signing secret for stateless unsubscribe links
# (GET /api/email/unsubscribe?token=...). When unset, emails link to the
# settings page instead. Generate with: openssl rand -hex 32
EMAIL_UNSUBSCRIBE_JWT_SECRET=
# OPTIONAL: Comma-separated rotation secrets verified alongside the primary
# secret (newest first), mirroring the jwt-secret rotation pattern.
EMAIL_UNSUBSCRIBE_JWT_SECRETS=

# [[AUTH]]
AUTH_ENCRYPTION_KEY="secret"
# OPTIONAL: Comma-separated browser origins allowed to call the API
# (better-auth trustedOrigins). Defaults to APP_URL, API_URL, and
# *.localhost:3001 when unset. In production, public board subdomains need a
# wildcard for the root domain, e.g. *.feeblo.com (scheme-less patterns match
# both http and https hosts).
AUTH_TRUSTED_ORIGINS=

# [[SOCIAL AUTH]]
# GitHub/Google OAuth client credentials. Set these to the values registered
# with the real providers (production) or the local emulator's oauth_apps /
# oauth_clients (development, see emulate.config.yaml).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# OPTIONAL: When set, the matching provider above is pointed at the local
# OAuth emulator (vercel-labs/emulate) instead of the real provider; the
# built-in better-auth provider is used when unset. Example values:
#   GITHUB_EMULATOR_URL=http://localhost:4000
#   GOOGLE_EMULATOR_URL=http://localhost:4001
# or with portless: https://github.emulate.localhost / https://google.emulate.localhost
GITHUB_EMULATOR_URL=
GOOGLE_EMULATOR_URL=

# [[APP]]
APP_URL=http://localhost:3001
API_URL=http://localhost:3000
APP_ROOT_DOMAIN=localhost:3001
APP_RELEASE=dev
# OPTIONAL: Set to any truthy value to prevent search engines from indexing the site (e.g. for staging)
NO_INDEX=

# [[BILLING]]
# OPTIONAL: Enables Polar checkout, customer portal, and signed webhooks when
# both credentials are configured. Use sandbox while testing.
POLAR_MODE=sandbox
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=

# [[SENTRY]]
# OPTIONAL: Enables server error tracking, tracing, logs, and metrics when configured.
SENTRY_DSN=
# OPTIONAL: Sentry environment label. Defaults to NODE_ENV; set to staging while NODE_ENV remains production.
SENTRY_ENVIRONMENT=
# OPTIONAL: Percentage of transactions to trace (0.0–1.0). Defaults to 0.1.
SENTRY_TRACES_SAMPLE_RATE=0.1

# [[POST_EMBEDDINGS]]
# OPTIONAL: Enables AI-powered post embeddings and semantic suggestions.
# The API must implement the OpenAI embeddings endpoint.
EMBEDDING_API_KEY=
# OPTIONAL: Defaults to text-embedding-3-small.
EMBEDDING_MODEL=text-embedding-3-small
# OPTIONAL: Defaults to 1536. Run db:configure-embeddings when changing this.
EMBEDDING_DIMENSIONS=1536
# OPTIONAL: Override for OpenAI-compatible providers such as Hugging Face or Ollama.
EMBEDDING_API_URL=

# [[MEDIA_UPLOAD]]

MEDIA_UPLOAD_REGION="us-east-1" # value should be 'auto' while using r2
MEDIA_UPLOAD_ENDPOINT="http://127.0.0.1:9002"
MEDIA_UPLOAD_ACCESS_KEY_ID="feeblo"
MEDIA_UPLOAD_SECRET_ACCESS_KEY="password"
MEDIA_PUBLIC_BUCKET_NAME="feeblo-media-public"

# [[POSTHOG]]
# OPTIONAL: PostHog project API key. When omitted, all analytics is disabled.
POSTHOG_KEY=
# OPTIONAL: PostHog instance host. Defaults to https://us.i.posthog.com
POSTHOG_HOST=

# [[SUBDOMAIN_VALIDATION]]
# OPTIONAL: Comma-separated profanity words appended to the bundled dictionary.
PROFANITY_EXTRA_WORDS=
