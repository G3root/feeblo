{
  "$schema": "https://raw.githubusercontent.com/Effect-TS/language-service/refs/heads/main/schema.json",
  "extends": "@feeblo/config/tsconfig.base.json",
  "include": ["**/*.ts"],
  "compilerOptions": {
    // Specs evaluate code in the browser context (e.g. HTMLInputElement),
    // which needs the DOM lib on top of the ESNext default.
    "lib": ["ESNext", "DOM"],
    "types": ["node"]
  }
}
